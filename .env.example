# AI Application Compiler — Environment Variables

# OpenAI Configuration (required for LLM-powered pipeline)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Database (used by Docker Compose)
DATABASE_URL=postgresql://compiler:compiler@localhost:5432/ai_compiler

# Backend Server
HOST=0.0.0.0
PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
